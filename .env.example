# Postgres connection string from Neon / Supabase / Railway (or any managed Postgres).
# Include ?sslmode=require if your provider needs it.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# The password admins type in at /admin/login.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie. Use a long random string,
# e.g. generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
